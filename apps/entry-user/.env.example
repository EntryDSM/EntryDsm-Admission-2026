# Entry-User Environment Variables
# 개발 시 이 파일을 .env 로 복사해 값을 채운다. 배포 값은 Cloudflare Workers 빌드 변수로 주입된다 (docs/DEPLOYMENT.md 참고).

# 백엔드 API origin (개발 미설정 시 http://localhost:3000 폴백)
VITE_API_BASE_URL=

# 공용 헤더 링크 (@entry/ui — 프로덕션 빌드에서 필수)
VITE_USER_APP_URL=
VITE_AUTH_APP_URL=

# entry-user 전용 링크 (프로덕션 빌드에서 필수)
VITE_ADMISSION_APP_URL=
VITE_SCHOOL_HOMEPAGE_URL=
