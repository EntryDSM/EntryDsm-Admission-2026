# Entry-Auth Environment Variables
# 개발 시 이 파일을 .env 로 복사해 값을 채운다. 배포 값은 Cloudflare Workers 빌드 변수로 주입된다 (docs/DEPLOYMENT.md 참고).

# 인증 백엔드 API origin
VITE_IDENTITY_API_URL=

# 공용 헤더 링크 (@entry/ui — 프로덕션 빌드에서 필수)
# VITE_USER_APP_URL 은 로그인 후 리디렉션 대상으로도 쓰인다.
VITE_USER_APP_URL=http://localhost:8000
VITE_AUTH_APP_URL=http://localhost:8001
VITE_AWS_CONSOLE_URL=

# role별 로그인 리디렉션 (프로덕션 빌드에서 필수)
VITE_ADMIN_APP_URL=http://localhost:8003
VITE_MONITORING_APP_URL=http://localhost:8004
