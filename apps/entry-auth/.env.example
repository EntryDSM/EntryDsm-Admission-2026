# Entry-Auth Environment Variables
# 개발 시 이 파일을 .env 로 복사해 값을 채운다. 배포 값은 GitHub Environment Variables 로 주입된다 (docs/DEPLOYMENT.md 7-4).

# 인증 백엔드 API origin
VITE_IDENTITY_API_URL=

# 공용 헤더 링크 (@entry/ui — 프로덕션 빌드에서 필수)
# VITE_USER_APP_URL 은 로그인 후 리디렉션 대상으로도 쓰인다.
VITE_USER_APP_URL=https://entrydsm.hs.kr
VITE_AUTH_APP_URL=https://auth.entrydsm.hs.kr
VITE_AWS_CONSOLE_URL=https://179895363651.signin.aws.amazon.com/console
