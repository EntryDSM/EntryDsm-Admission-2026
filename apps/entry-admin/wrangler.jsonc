{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "entry-admin",
  "compatibility_date": "2026-09-08",
  // 정적 자산만 서빙한다. SPA 라우트를 새로고침하면 index.html 을 준다.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // workers.dev 주소 없이 커스텀 도메인으로만 서빙한다.
  "workers_dev": false,
  "routes": [{ "pattern": "admin.entrydsm.hs.kr", "custom_domain": true }],
  // 스테이징(develop): `wrangler deploy -e stag`. 이름·도메인 말고는 위 설정을 따른다.
  "env": {
    "stag": {
      "name": "entry-admin-stag",
      "workers_dev": false,
      "routes": [{ "pattern": "stag-admin.entrydsm.hs.kr", "custom_domain": true }]
    }
  }
}
