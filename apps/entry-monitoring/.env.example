# Entry-Monitoring Environment Variables
# 개발 시 이 파일을 .env 로 복사해 값을 채운다. 배포 값은 Cloudflare Workers 빌드 변수로 주입된다 (docs/DEPLOYMENT.md 참고).

# 백엔드 API origin
VITE_API_BASE_URL=

# 공용 헤더 링크 (@entry/ui — 프로덕션 빌드에서 필수)
VITE_USER_APP_URL=http://localhost:8000
VITE_AUTH_APP_URL=http://localhost:8001
VITE_AWS_CONSOLE_URL=

# Sentry 오류 수집 (docs/OBSERVABILITY.md). 비우면 SDK 가 꺼진다 — 로컬 개발 기본값. 배포 값은 Worker 별 빌드 변수로 주입한다.
VITE_SENTRY_DSN=
# production | staging (prod / stag Worker 별로 다르게). 미설정 시 development.
VITE_SENTRY_ENVIRONMENT=
