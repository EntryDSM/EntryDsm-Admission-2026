# Entry-Monitoring Environment Variables
# 개발 시 이 파일을 .env 로 복사해 값을 채운다. 배포 값은 Cloudflare Pages 프로젝트의 환경 변수로 주입된다 (docs/DEPLOYMENT.md 참고).

# 백엔드 API origin
VITE_API_BASE_URL=

# 모집 회차 (미설정 시 2026-1 폴백)
VITE_ADMISSION_ROUND=

# 공용 헤더 링크 (@entry/ui — 프로덕션 빌드에서 필수)
VITE_USER_APP_URL=
VITE_AUTH_APP_URL=
